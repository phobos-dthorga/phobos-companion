      "kind": "reads",
      "why": "reads"
    },

    {
      "programs": ["git"],
      "sub": ["push"],
      "any": ["--delete", "-d", ":*"],
      "kind": "changes",
      "why": "deletes-online",
      "warn": true
    },
    {
      "programs": ["git"],
      "sub": [
        "reset",
        "clean",
        "checkout",
        "restore",
        "switch",
        "stash",
        "worktree"
