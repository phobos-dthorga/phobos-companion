      "why": "throws-away-work",
      "warn": true
    },
    {
      "programs": ["git"],
      "sub": ["push", "pull", "fetch", "clone", "ls-remote", "submodule"],
      "kind": "changes",
      "why": "goes-online"
    },
    { "programs": ["git"], "kind": "changes", "why": "changes-git" },
    { "programs": ["gh"], "kind": "changes", "why": "goes-online" },
    {
