{
  "version": 1,
  "about": "How the Chat page sorts a command an agent wants to run (0.84.0; docs/ai.md, Commands; the owner's choices by card, 25 Nov 2026). Rules are tried in order and the first that matches a simple command decides it: forbidden first (refused even with a yes), then tests and the gate, the tool kit's own list of what each report does, reading, and what changes something. A command no rule names asks. Read by companion_core::commands; game-free.",
  "environment": [
    "PYTHONIOENCODING",
    "PYTHONUTF8",
    "PYTHONDONTWRITEBYTECODE",
    "NO_COLOR",
    "FORCE_COLOR",
    "CLICOLOR",
    "TERM",
    "LANG",
    "LC_ALL",
    "GIT_PAGER",
    "PAGER",
    "CI"
  ],
  "shells": {
    "bash": ["-c", "-lc"],
    "sh": ["-c"],
    "zsh": ["-c", "-lc"],
    "pwsh": ["-command", "-c"],
    "powershell": ["-command", "-c"],
    "cmd": ["/c"]
  },
  "valued": {
    "git": ["-c", "-C", "--git-dir", "--work-tree", "--namespace"],
    "cargo": ["--manifest-path", "-p", "--package", "--target-dir"],
    "npm": ["--prefix"],
    "dotnet": ["-c", "--configuration", "-f", "--framework"],
    "python": ["-X", "-W"],
    "python3": ["-X", "-W"],
    "py": ["-X", "-W"]
  },
  "kit": { "programs": ["python", "python3", "py"], "module": "phobos_modkit" },
  "rules": [
    {
      "programs": ["git"],
      "sub": ["push"],
      "any": [
        "--force",
        "-f",
        "--force-with-lease*",
        "--force-if-includes",
        "--mirror",
        "+*"
      ],
      "kind": "forbidden",
      "why": "force-push"
    },
    {
      "programs": ["git"],
      "sub": ["rebase", "filter-branch", "filter-repo", "replace"],
      "kind": "forbidden",
      "why": "rewrites-history"
    },
    {
      "programs": ["git"],
      "sub": ["commit"],
      "any": ["--amend", "--fixup*", "--squash*"],
      "kind": "forbidden",
      "why": "rewrites-history"
    },
    {
      "programs": ["git"],
      "sub": ["commit"],
      "any": ["-n"],
      "kind": "forbidden",
      "why": "skips-checks"
    },
    {
      "programs": ["*"],
      "any": [
        "--no-verify",
        "*commit.gpgsign=false",
        "--no-gpg-sign",
        "*core.hookspath*"
      ],
      "kind": "forbidden",
      "why": "skips-checks"
    },
    {
      "programs": ["gh"],
      "sub": ["repo"],
      "all": ["edit"],
      "any": ["--visibility*"],
      "kind": "forbidden",
      "why": "visibility"
    },
    {
      "programs": ["gh"],
      "sub": ["auth"],
      "any": ["token", "login", "refresh"],
      "kind": "forbidden",
      "why": "credentials"
    },
    {
      "programs": ["git"],
      "sub": ["credential", "credential-manager", "credential-store"],
      "kind": "forbidden",
      "why": "credentials"
    },
    {
      "programs": ["cmdkey", "vaultcmd", "security"],
      "kind": "forbidden",
      "why": "credentials"
    },
    {
      "programs": ["steamcmd", "steamcmd.sh"],
      "kind": "forbidden",
      "why": "owner-only"
    },
    {
      "programs": [
        "rm",
        "del",
        "erase",
        "rd",
        "rmdir",
        "mv",
        "move",
        "cp",
        "copy",
        "ren",
        "rename",
        "remove-item",
        "ri",
        "move-item",
        "mi",
        "copy-item",
        "cpi",
        "rename-item",
        "rni",
        "set-content",
        "out-file",
        "add-content",
        "clear-content",
        "tee"
      ],
      "any": ["*.rws", "*/saves/*", "*/saves"],
      "kind": "forbidden",
      "why": "saves"
    },

    {
      "programs": ["python", "python3", "py"],
      "sub": ["scripts/check-all.py", "scripts\\check-all.py"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["python", "python3", "py"],
      "all": ["-m", "phobos_modkit"],
      "any": ["gate"],
      "none": ["--write*", "--fix"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["python", "python3", "py"],
      "all": ["-m"],
      "any": ["unittest", "pytest"],
      "kind": "tests",
      "why": "tests"
    },
    { "programs": ["pytest"], "kind": "tests", "why": "tests" },
    {
      "programs": ["npm", "pnpm", "yarn"],
      "sub": ["test", "t"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["npm", "pnpm", "yarn"],
      "sub": ["run"],
      "then": ["test", "test:*", "check", "lint"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["npx"],
      "sub": ["vitest", "svelte-check", "eslint"],
      "none": ["--fix", "-u", "--update"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["npx"],
      "sub": ["playwright"],
      "then": ["test"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["npx"],
      "sub": ["prettier"],
      "any": ["--check", "-c"],
      "none": ["--write", "-w"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["cargo"],
      "sub": ["test", "check", "clippy"],
      "none": ["--fix"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["cargo"],
      "sub": ["fmt"],
      "any": ["--check"],
      "kind": "tests",
      "why": "tests"
    },
    {
      "programs": ["dotnet"],
      "sub": ["test"],
      "kind": "tests",
      "why": "tests"
    },

    { "kit": true },

    {
      "programs": ["git"],
      "sub": [
        "status",
        "log",
        "diff",
        "show",
        "blame",
        "ls-files",
        "ls-tree",
        "rev-parse",
        "describe",
        "shortlog",
        "grep",
        "cat-file",
        "rev-list",
        "merge-base",
        "name-rev",
        "whatchanged",
        "show-ref",
        "for-each-ref",
        "count-objects",
        "check-ignore",
        "var",
        "version",
        "help"
      ],
      "none": ["--output*", "--ext-diff", "--textconv", "-o"],
      "kind": "reads",
      "why": "reads"
    },
    {
      "programs": ["git"],
      "sub": ["branch", "tag"],
      "bare": true,
      "none": [
        "-d",
        "-D",
        "-m",
        "-M",
        "-c",
        "-C",
        "--delete",
        "--move",
        "--copy",
        "-u",
        "--set-upstream-to*",
