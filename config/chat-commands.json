    },
    {
      "programs": [
        "pwd",
        "get-location",
        "which",
        "where",
        "where.exe",
        "get-command",
        "gcm",
        "whoami",
        "echo",
        "printf",
        "write-output",
        "write-host",
        "date",
        "get-date",
