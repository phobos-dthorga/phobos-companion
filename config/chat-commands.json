      "kind": "reads",
      "why": "reads"
    },
    {
      "programs": ["git"],
      "sub": ["stash"],
      "then": ["list", "show"],
      "kind": "reads",
      "why": "reads"
    },
    {
      "programs": ["git"],
      "sub": ["reflog"],
      "then": ["", "show"],
      "kind": "reads",
      "why": "reads"
    },
    {
      "programs": ["git"],
      "sub": ["remote"],
      "bare": true,
      "kind": "reads",
      "why": "reads"
    },
    {
      "programs": ["git"],
      "sub": ["config"],
      "any": ["--get*", "--list", "-l"],
      "kind": "reads",
      "why": "reads"
    },
    { "programs": ["git"], "sub": [""], "kind": "reads", "why": "reads" },
    {
      "programs": ["find"],
      "none": [
        "-delete",
        "-exec",
        "-execdir",
        "-ok",
        "-okdir",
        "-fprint*",
        "-fls"
      ],
      "paths": true,
      "kind": "reads",
      "why": "reads"
    },
    {
      "programs": ["rg"],
      "none": ["--pre*", "--search-zip", "-z"],
      "paths": true,
      "kind": "reads",
      "why": "reads"
    },
    {
      "programs": [
        "ls",
        "dir",
        "cat",
        "type",
        "head",
        "tail",
        "wc",
        "tree",
