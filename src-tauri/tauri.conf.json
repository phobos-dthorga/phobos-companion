{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D’thorga Companion",
  "mainBinaryName": "phobos-companion",
  "version": "0.115.0",
  "identifier": "org.phobosdthorga.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "D'thorga Companion",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' blob: ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Phobos A. D’thorga",
    "shortDescription": "One desktop program for every game you mod",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3MjlDMDQ2ODY3RjM5NTYKUldSV09YK0dSc0FwOTBEMXBZamtWRjBrNGY1NmZoc0UyNStBdVhsZk5sMVMxZ2RseEMxcHFCTFgK",
      "endpoints": [
        "https://github.com/phobos-dthorga/phobos-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
